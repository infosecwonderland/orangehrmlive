{
  "name": "orangehrmlive",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome --env allure=true",
    "test:firefox": "cypress run --browser firefox --env allure=true",
    "test:allure": "cypress run --env allure=true",
    "test:parallel": "concurrently \"SPLIT=2 SPLIT_INDEX=0 cypress run --env allure=true\" \"SPLIT=2 SPLIT_INDEX=1 cypress run --env allure=true\"",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
