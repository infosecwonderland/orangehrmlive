  "type": "commonjs",
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.12.0",
    "cypress-split": "^1.24.31",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
